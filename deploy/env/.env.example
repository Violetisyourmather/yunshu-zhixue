# ============================================================
# 云枢智学 · 基础服务环境变量模板
# 用法：在 deploy/ 目录执行  copy env\.env.example .env
#      （PowerShell）或  cp env/.env.example .env （Git Bash）
#
# 说明：
#   1. compose 只会读取「compose 文件同目录」的 .env，故必须复制到 deploy/.env
#   2. 未配置时使用 docker-compose.yml 中的默认值，开箱即可启动
#   3. 上线前必须替换所有默认密码；.env 不得提交到代码仓库
# ============================================================

# ---------- MySQL ----------
MYSQL_IMAGE=mysql:8.0
MYSQL_ROOT_PASSWORD=yszx_root_2026
MYSQL_DATABASE=yszx
MYSQL_USER=yszx
MYSQL_PASSWORD=yszx_2026
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=yszx_redis_2026
REDIS_PORT=6379

# ---------- MinIO ----------
# 官方 minio/minio 已停止发布；pgsty/minio 为社区维护的 MinIO 本体镜像。
# 如需替换实现（如 rustfs/rustfs、bitnamilegacy/minio），只改这一行即可。
MINIO_IMAGE=pgsty/minio:latest
# 根账号密码：长度均需 >= 8
MINIO_ROOT_USER=yszxadmin
MINIO_ROOT_PASSWORD=yszx_minio_2026
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
