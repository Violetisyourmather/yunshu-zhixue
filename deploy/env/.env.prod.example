# 复制为 deploy/.env 后填写；不要提交真实密钥
# cp deploy/env/.env.prod.example deploy/.env

# Web 入口端口（外层负载均衡可改为 80/443）
WEB_PORT=8088

# HTTPS（仅叠加 docker-compose.https.yml 时生效）
WEB_HTTPS_PORT=443
# 证书目录，默认为 deploy/certs
# TLS_CERT_DIR=./certs

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=yszx
MYSQL_USER=yszx
MYSQL_PASSWORD=change-me-mysql

# Redis
REDIS_PASSWORD=change-me-redis

# MinIO（后端使用同一组凭据）
MINIO_ROOT_USER=yszxadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=yszx-media

# JWT（各端独立，>=32 字节；上线必须替换）
JWT_PORTAL_SECRET=replace-with-at-least-32-bytes-portal-secret
JWT_ADMIN_SECRET=replace-with-at-least-32-bytes-admin-secret

# 后台重置密码默认值（首次启动内置 admin 使用）
APP_DEFAULT_PASSWORD=change-me-admin-password

# AI（OpenAI 兼容协议；留空则 AI 批改降级）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-pro
MIMO_TIMEOUT_SECONDS=60
